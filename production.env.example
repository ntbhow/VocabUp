# Copy to an untracked deployment env file and replace every value with unique secrets.
DB_PASSWORD=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_HEX
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_HEX
FRONTEND_URL=https://vocabup.example.com
TRUST_PROXY=1
APP_PORT=4000
# Upload caps in MB (APKG/CSV/illustration). Keep nginx client_max_body_size >= APKG cap.
APKG_MAX_SIZE_MB=200
CSV_MAX_SIZE_MB=50
IMAGE_MAX_SIZE_MB=5
# Vocabulary image providers (server-side only; never exposed to the browser).
# Pixabay/Unsplash/Pexels/Flickr need a key; Wikimedia Commons/Openverse work without one.
# PIXABAY_API_KEY=
# UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=
# FLICKR_API_KEY=
# IMAGE_PROVIDERS=pixabay,unsplash,pexels,wikimedia,openverse,flickr
# IMAGE_REQUEST_DELAY_MS=650
# IMAGE_RETRY_INTERVAL_MINUTES=360
# IMAGE_RETRY_BATCH=100
