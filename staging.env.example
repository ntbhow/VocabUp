# Copy to an untracked staging.env and replace every value with unique staging-only secrets.
STAGING_DB_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_SECRET
STAGING_MYSQL_ROOT_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
STAGING_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES_HEX
STAGING_FRONTEND_URL=https://staging.vocabup.example.com
STAGING_TRUST_PROXY=1
STAGING_APP_PORT=4001
STAGING_APKG_MAX_SIZE_MB=200
STAGING_CSV_MAX_SIZE_MB=50
STAGING_IMAGE_MAX_SIZE_MB=5
# Staging image providers (server-side only). Leave keys empty to use Wikimedia/Openverse.
# STAGING_PIXABAY_API_KEY=
# STAGING_UNSPLASH_ACCESS_KEY=
# STAGING_PEXELS_API_KEY=
# STAGING_FLICKR_API_KEY=
# STAGING_IMAGE_PROVIDERS=pixabay,unsplash,pexels,wikimedia,openverse,flickr
# STAGING_IMAGE_REQUEST_DELAY_MS=650
# STAGING_IMAGE_RETRY_INTERVAL_MINUTES=360
# STAGING_IMAGE_RETRY_BATCH=100
