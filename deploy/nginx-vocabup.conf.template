# Substitute __DOMAIN__, __TLS_CERT_PATH__, and __TLS_KEY_PATH__ from deployment
# configuration before enabling this file. These are placeholders, not valid values.
server {
    listen 80;
    server_name __DOMAIN__;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name __DOMAIN__;

    ssl_certificate __TLS_CERT_PATH__;
    ssl_certificate_key __TLS_KEY_PATH__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_timeout 1d;
    ssl_session_cache shared:VocabUpTLS:10m;
    ssl_session_tickets off;

    server_tokens off;
    # APKG import is capped at APKG_MAX_SIZE_MB (default 200 MB) by Express, so the
    # reverse proxy must allow at least that plus multipart/HTTP headroom. If a CDN
    # or tunnel (e.g. Cloudflare's 100 MB free plan) sits in front, raise it there too.
    client_max_body_size 210m;
    client_body_timeout 300s;
    proxy_hide_header Strict-Transport-Security;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
