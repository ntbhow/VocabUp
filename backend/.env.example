PORT=4000
# Comma-separated exact browser origins. Production frontend and API should share a site for SameSite=Strict cookies.
FRONTEND_URL=http://localhost:5173
DB_HOST=localhost
DB_PORT=3307
DB_NAME=vocabup
DB_USER=vocabup
# Local Compose development credential only; production must use a strong unique value.
DB_PASSWORD=vocabup
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
# Set to 1 only when exactly one trusted TLS reverse proxy is in front of Express.
TRUST_PROXY=0

# Admin bootstrap is a one-off CLI (`npm run admin:create -w backend`). These values are
# read from the environment, are never written by the server, and must not be committed.
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Platform Administrator
# ADMIN_PASSWORD=use-a-strong-12-plus-character-password

# Vocabulary illustration search (server-side only; keys are never sent to the browser).
# Pixabay, Unsplash, Pexels and Flickr require a key; Wikimedia Commons and Openverse
# work without one and are enabled by default.
#   Pixabay   https://pixabay.com/api/docs/
#   Unsplash  https://unsplash.com/developers
#   Pexels    https://www.pexels.com/api/
#   Flickr    https://www.flickr.com/services/apps/create/
# PIXABAY_API_KEY=your-pixabay-key
# UNSPLASH_ACCESS_KEY=your-unsplash-access-key
# PEXELS_API_KEY=your-pexels-key
# FLICKR_API_KEY=your-flickr-key
# Restrict the sources (default: every configured provider).
# IMAGE_PROVIDERS=pixabay,unsplash,wikimedia
# Disable the keyless sources if desired.
# IMAGE_DISABLE_WIKIMEDIA=1
# IMAGE_DISABLE_OPENVERSE=1
# Pause between upstream requests (ms) to respect free-tier rate limits.
# IMAGE_REQUEST_DELAY_MS=650
# Automatic retry queue for cards that still have no image after import/manual runs.
# IMAGE_RETRY_ENABLED=1
# IMAGE_RETRY_INTERVAL_MINUTES=360
# IMAGE_RETRY_BATCH=100
# IMAGE_RETRY_MAX_ATTEMPTS=5
# Optional base URL overrides (useful for tests or a provider proxy).
# PIXABAY_API_BASE_URL=https://pixabay.com/api/
# UNSPLASH_API_BASE_URL=https://api.unsplash.com/search/photos
# PEXELS_API_BASE_URL=https://api.pexels.com/v1/search
# WIKIMEDIA_API_BASE_URL=https://commons.wikimedia.org/w/api.php
# OPENVERSE_API_BASE_URL=https://api.openverse.org/v1/images/
# FLICKR_API_BASE_URL=https://api.flickr.com/services/rest/
# Directory for uploaded illustrations. Defaults to backend/uploads.
# UPLOAD_DIR=
# Upload caps in MB. Each file type has its own limit; do not use one value for all.
# APKG_MAX_SIZE_MB=200
# CSV_MAX_SIZE_MB=50
# IMAGE_MAX_SIZE_MB=5
# Disk-backed temp directory for streamed uploads / extracted APKG databases.
# UPLOAD_TMP_DIR=
# Node HTTP request timeout for large uploads (ms). Defaults to 600000 (10 min).
# REQUEST_TIMEOUT_MS=600000
